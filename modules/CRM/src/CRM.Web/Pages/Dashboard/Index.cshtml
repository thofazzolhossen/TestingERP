@page
@model CRM.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

@section styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: #f5f7fb;
            font-family: Inter, Arial, sans-serif;
            color: #263248;
            font-size: 13px;
        }

        .dashboard { padding: 24px; }

        .page-title {
            font-size: 23px;
            font-weight: 700;
            color: #17243b;
        }

        .subtitle { color: #8490a4; font-size: 12px; }

        .crm-card, .kpi-card {
            background: #fff;
            border: 1px solid #e9edf4;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(30, 50, 80, .025);
        }

        .kpi-card { padding: 17px; height: 100%; }

        .kpi-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: 18px;
        }

        .blue { background: #edf2ff; color: #4263eb; }
        .green { background: #e7f8ef; color: #20a464; }
        .orange { background: #fff2e5; color: #e99532; }
        .purple { background: #f2eefe; color: #7950c5; }
        .red { background: #ffebeb; color: #d84c4c; }

        .kpi-value {
            font-size: 26px;
            font-weight: 700;
            margin-top: 3px;
            color: #202d43;
        }

        .kpi-footer {
            font-size: 11px;
            margin-top: 7px;
        }

        .crm-card { padding: 18px; height: 100%; }

        .card-heading {
            font-size: 14px;
            font-weight: 700;
            color: #263248;
        }

        .card-subtitle {
            color: #98a1b2;
            font-size: 11px;
            margin-top: 4px;
        }

        .chart-container {
            position: relative;
            height: 245px;
            margin-top: 20px;
        }

        .pipeline-row { margin-top: 16px; }

        .pipeline-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 12px;
            font-weight: 600;
        }

        .progress {
            height: 8px;
            background: #edf0f5;
            border-radius: 20px;
        }

        .progress-bar { border-radius: 20px; }

        .badge-soft {
            padding: 5px 9px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 10px;
        }

        .badge-success { background: #e7f8ef; color: #15945a; }
        .badge-warning { background: #fff3df; color: #d68a20; }
        .badge-danger { background: #ffebeb; color: #d84c4c; }
        .badge-info { background: #eaf1ff; color: #4263eb; }

        .followup {
            padding: 11px 0;
            border-bottom: 1px solid #f0f2f6;
        }
        .followup:last-child { border-bottom: 0; }
        .followup-name { font-weight: 600; font-size: 12px; color: #263248; }
        .followup-info { font-size: 11px; color: #8c97a9; margin-top: 3px; }

        .rank-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }
        .rank-item:last-child { margin-bottom: 0; }
        .rank-bar { height: 8px; border-radius: 6px; background: #e2e8f0; flex: 1; overflow: hidden; }
        .rank-bar i { display: block; height: 100%; background: linear-gradient(90deg,#4263eb,#06b6d4); border-radius: 6px; }

        @@media(max - width: 768px) {
            .dashboard { padding: 13px; }
            .kpi-value { font-size: 22px; }
        }
    </style>
}

<div class="dashboard">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <div class="page-title">CRM Dashboard</div>
            <div class="subtitle">Monitor your sales performance and customer activities</div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="text-secondary small">
                <i class="bi bi-circle-fill text-success me-1" style="font-size:7px"></i>
                Live Overview &middot; <span id="updated">loading...</span>
            </span>
            <button id="btnRefresh" class="btn btn-sm btn-light border">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>

    <!-- KPI Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="subtitle">Total Leads</span>
                    <div class="kpi-icon blue"><i class="bi bi-people"></i></div>
                </div>
                <div class="kpi-value" id="kTotal">0</div>
                <div class="kpi-footer text-success"><i class="bi bi-graph-up-arrow me-1"></i><span id="kTotalSub">0 new this month</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="subtitle">Pipeline Value</span>
                    <div class="kpi-icon green"><i class="bi bi-currency-dollar"></i></div>
                </div>
                <div class="kpi-value" id="kValue">0</div>
                <div class="kpi-footer text-success"><i class="bi bi-wallet2 me-1"></i><span id="kAvgSub">Avg 0 per lead</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="subtitle">Due Today</span>
                    <div class="kpi-icon orange"><i class="bi bi-bell"></i></div>
                </div>
                <div class="kpi-value" id="kToday">0</div>
                <div class="kpi-footer text-warning"><i class="bi bi-clock me-1"></i>Follow-ups scheduled today</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="kpi-top">
                    <span class="subtitle">Overdue Follow-ups</span>
                    <div class="kpi-icon red"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
                <div class="kpi-value" id="kLate">0</div>
                <div class="kpi-footer text-danger"><i class="bi bi-exclamation-circle me-1"></i>Requires immediate action</div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="crm-card">
                <div class="card-heading">Lead Inflow & Performance</div>
                <div class="card-subtitle">Lead generation trend over the last 30 days</div>
                <div class="chart-container">
                    <canvas id="chTrend"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="crm-card">
                <div class="card-heading">Lead Sources</div>
                <div class="card-subtitle">Distribution of leads by source</div>
                <div class="chart-container">
                    <canvas id="chSource"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Pipeline + Follow-up Overview -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="crm-card">
                <div class="card-heading">Sales Pipeline</div>
                <div class="card-subtitle">Current distribution of leads by stage</div>
                <div id="pipelineContainer" class="mt-3"></div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="crm-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="card-heading">Follow-up Overview</div>
                        <div class="card-subtitle">Upcoming scheduled follow-ups</div>
                    </div>
                    <span class="badge-soft badge-danger" id="overdueBadge">0 Overdue</span>
                </div>
                <div id="followupContainer" class="mt-3"></div>
            </div>
        </div>
    </div>

    <!-- Additional Breakdowns & Leaderboard -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="crm-card">
                <div class="card-heading">Top Performers</div>
                <div class="card-subtitle">Leading assignees by lead count & pipeline value</div>
                <div id="rankContainer" class="mt-3"></div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="crm-card">
                <div class="card-heading">Services & Customer Types</div>
                <div class="card-subtitle">Demand breakdown across services and segments</div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <div class="subtitle fw-bold mb-2 text-dark">Top Services</div>
                        <div style="height: 190px; position: relative;"><canvas id="chService"></canvas></div>
                    </div>
                    <div class="col-md-6">
                        <div class="subtitle fw-bold mb-2 text-dark">Customer Types</div>
                        <div style="height: 190px; position: relative;"><canvas id="chType"></canvas></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        window.dashUrl = '@Url.Page("/Dashboard/Index", "Data")';
    </script>
    <script src="/Pages/Dashboard/Index.js"></script>
}