@page
@model CRM.Web.Pages.FollowUps.IndexModel
@{
    ViewData["Title"] = "Lead Follow-Ups";
}

@section styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        .kpi-card {
            cursor: pointer;
            transition: all 0.2s ease;
            border: 2px solid transparent !important;
            border-radius: 12px;
        }

            .kpi-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08) !important;
            }

            .kpi-card.active-kpi {
                border-color: #2563eb !important;
                background-color: #f8fafc;
            }

        .kpi-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
    </style>
}

<div class="container-fluid py-2">
    <!-- ========================================================= -->
    <!-- 1. FROM & TO DATE RANGE FILTER BAR                        -->
    <!-- ========================================================= -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body py-3 px-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-secondary text-uppercase mb-1">
                        <i class="fa fa-calendar-day me-1 text-primary"></i> From Date
                    </label>
                    <input type="text" id="FilterFromDate" class="form-control form-control-sm" />
                </div>

                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-secondary text-uppercase mb-1">
                        <i class="fa fa-calendar-check me-1 text-primary"></i> To Date
                    </label>
                    <input type="text" id="FilterToDate" class="form-control form-control-sm" />
                </div>

                <div class="col-md-6 d-flex flex-wrap align-items-center gap-2">
                    <button type="button" id="BtnFilterLoad" class="btn btn-sm btn-primary px-3">
                        <i class="fa fa-filter me-1"></i> Load Follow-Ups
                    </button>
                    <button type="button" id="BtnFilterReset" class="btn btn-sm btn-outline-secondary px-3">
                        <i class="fa fa-rotate-left me-1"></i> Reset
                    </button>

                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 2. KPI SUMMARY CARDS (CLICK TO FILTER GRID)               -->
    <!-- ========================================================= -->
    <div class="row g-3 mb-3">
        <!-- Total Follow-Ups -->
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm kpi-card active-kpi" data-status="ALL">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Total Follow-Ups</div>
                        <h3 class="fw-bold mb-0 mt-1 text-dark" id="KpiTotalCount">0</h3>
                        <span class="text-muted" style="font-size: 0.75rem;">In selected date range</span>
                    </div>
                    <div class="kpi-icon bg-primary-subtle text-primary">
                        <i class="fa fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Overdue -->
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm kpi-card" data-status="OVERDUE">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-danger small fw-bold text-uppercase">Overdue</div>
                        <h3 class="fw-bold mb-0 mt-1 text-danger" id="KpiOverdueCount">0</h3>
                        <span class="text-muted" style="font-size: 0.75rem;">Past follow-up date</span>
                    </div>
                    <div class="kpi-icon bg-danger-subtle text-danger">
                        <i class="fa fa-triangle-exclamation"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Due Today -->
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm kpi-card" data-status="TODAY">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-warning small fw-bold text-uppercase">Due Today</div>
                        <h3 class="fw-bold mb-0 mt-1 text-warning" id="KpiTodayCount">0</h3>
                        <span class="text-muted" style="font-size: 0.75rem;">Requires action today</span>
                    </div>
                    <div class="kpi-icon bg-warning-subtle text-warning">
                        <i class="fa fa-bell"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming -->
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm kpi-card" data-status="UPCOMING">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-success small fw-bold text-uppercase">Upcoming</div>
                        <h3 class="fw-bold mb-0 mt-1 text-success" id="KpiUpcomingCount">0</h3>
                        <span class="text-muted" style="font-size: 0.75rem;">Scheduled for future</span>
                    </div>
                    <div class="kpi-icon bg-success-subtle text-success">
                        <i class="fa fa-clock"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 3. FOLLOW-UPS AG GRID (LIKE LEADS GRID)                   -->
    <!-- ========================================================= -->
    <div id="FollowUpsGrid"></div>
</div>

<!-- ========================================================= -->
<!-- 4. UPDATE / RESCHEDULE FOLLOW-UP MODAL                    -->
<!-- ========================================================= -->
<div class="modal fade" id="FollowUpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form id="FollowUpForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="FollowUpLeadId" name="LeadId" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="FollowUpModalTitle">
                        <i class="fa fa-calendar-check me-2"></i>Update Follow-Up
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-dark" id="ModalLeadName">-</div>
                        <div class="small text-muted" id="ModalLeadSubInfo">-</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Next Follow-Up Date</label>
                        <input type="date" id="FollowUpNextDate" name="NextFollowUpDate" class="form-control" />
                        <div class="form-text">Leave blank if no further follow-up is needed.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lead Stage <span class="text-danger">*</span></label>
                        <select id="FollowUpStageId" name="LeadStageId" class="form-select select2-followup" required>
                            @foreach (var item in Model.LeadStages)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assigned User</label>
                        <select id="FollowUpAssignedUserId" name="AssignedUserId" class="form-select select2-followup">
                            <option value="">-- Unassigned --</option>
                            @foreach (var item in Model.Users)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Follow-Up Remarks / Outcome</label>
                        <textarea id="FollowUpRemarks" name="Remarks" class="form-control" rows="3" maxlength="1000" placeholder="Enter call summary or next steps..."></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="BtnSaveFollowUp" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/Pages/FollowUps/Index.js"></script>
}