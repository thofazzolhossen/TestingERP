@page
@model CRM.Web.Pages.LeadSources.IndexModel

@{
    ViewData["Title"] = "Lead Sources";
}

<div id="LeadSourcesGrid"></div>


<!-- ========================================================= -->
<!-- CREATE MODAL -->
<!-- ========================================================= -->

<div class="modal fade" id="LeadSourchModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="CreateForm">
                @Html.AntiForgeryToken()

                <!-- Hidden field to store the entity ID for editing -->
                <input type="hidden" id="EntityId" name="Id" value="" />

                <div class="modal-header">
                    <h5 class="modal-title" id="ModalTitle">
                        New Lead Source
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">
                            Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               id="EntityName"
                               name="Name"
                               class="form-control"
                               maxlength="128"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea id="EntityDescription"
                                  name="Description"
                                  class="form-control"
                                  rows="3"
                                  maxlength="512"></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox"
                               id="EntityIsActive"
                               name="IsActive"
                               value="true"
                               class="form-check-input"
                               checked />
                        <label class="form-check-label" for="EntityIsActive">
                            Is Active
                        </label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" id="SaveButton" class="btn btn-primary">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section scripts {

    <script>
        window.leadSourceUrls = {
            list: '@Url.Page("/LeadSources/Index", "List")',
            create: '@Url.Page("/LeadSources/Index")?handler=Create',
            update: '@Url.Page("/LeadSources/Index")?handler=Update',
            delete: '@Url.Page("/LeadSources/Index", "Delete")'
        };

    </script>
    <script src="/Pages/LeadSources/Index.js"></script>
}