@page
@model CRM.Web.Pages.LeadStages.IndexModel
@{
    ViewData["Title"] = "Lead Stages";
}

<!-- Custom Styles for AG Grid Quartz Theme matching index.html -->
<style>
    .ag-theme-quartz {
        --ag-header-background-color: #f8f9fa;
        --ag-row-hover-color: #f1f3f5;
        font-size: 0.875rem;
    }
</style>
<div id="LeadStagesGrid"></div>

<!-- Modal -->
<div class="modal fade" id="LeadStageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="LeadStageForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="StageId" name="Id" />

                <div class="modal-header">
                    <h5 class="modal-title" id="ModalTitle">New Lead Stage</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" id="StageName" name="Name" class="form-control" maxlength="128" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea id="StageDescription" name="Description" class="form-control" rows="3" maxlength="512"></textarea>
                    </div>

                    <div class="form-check mb-2">
                        <input type="checkbox" id="StageIsActive" name="IsActive" class="form-check-input" checked />
                        <label class="form-check-label" for="StageIsActive">Is Active</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="SaveButton" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        window.leadStageUrls = {
            list: '@Url.Page("/LeadStages/Index", "List")',
            create: '@Url.Page("/LeadStages/Index")?handler=Create',
            update: '@Url.Page("/LeadStages/Index")?handler=Update',
            delete: '@Url.Page("/LeadStages/Index", "Delete")'
        };
    </script>
    <script src="/Pages/LeadStages/Index.js"></script>
}