@page
@model CRM.Web.Pages.Sheets.SettingsModel
@{
    ViewData["Title"] = "Google Sheet Connection";
}
<div class="card shadow-sm" style="max-width:900px">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3"><i class="fa-brands fa-google-drive text-success me-2"></i>Google Sheet Connection</h5>
        <ol class="small">
            <li>Open your sheet → <b>Extensions → Apps Script</b>, paste the script below, save.</li>
            <li>Run <code>setup</code> once and authorize.</li>
            <li>Add or edit a row (Name + lookups filled). The Leads page updates instantly.</li>
        </ol>
        <textarea class="form-control font-monospace small" rows="22" readonly onclick="this.select()">@Model.ScriptText</textarea>
        <form method="post" asp-page-handler="Regenerate" class="mt-3">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger btn-sm">Regenerate secret (old script stops working)</button>
        </form>
    </div></div>